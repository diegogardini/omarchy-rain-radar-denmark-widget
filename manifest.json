{
  "schemaVersion": 1,
  "id": "io.github.diegogardini.omarchy-rain-radar-denmark-widget",
  "name": "Rain Radar Denmark",
  "version": "1.0.0",
  "author": "diegogardini",
  "description": "Animated DMI rain radar (observed + forecast) over a Denmark map",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Rain Radar Denmark",
    "description": "Animated radar + forecast rain map for Denmark",
    "category": "Weather",
    "defaultSection": "center",
    "allowMultiple": false,
    "defaults": {
      "refreshMinutes": 10,
      "autoPlay": true
    },
    "schema": [
      {
        "key": "refreshMinutes",
        "type": "number",
        "label": "Radar refresh interval",
        "description": "Minutes between DMI radar updates (minimum 5).",
        "defaultValue": 10,
        "min": 5,
        "max": 30,
        "step": 1
      },
      {
        "key": "autoPlay",
        "type": "boolean",
        "label": "Autoplay animation on open",
        "defaultValue": true
      }
    ]
  }
}
